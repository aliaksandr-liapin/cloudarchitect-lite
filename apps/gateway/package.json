{
  "name": "@cloudarchitect/gateway",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AI gateway: setup wizard, spending limits, LLM calls. Runs on Node.",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "build": "esbuild src/node.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/node.js --sourcemap --banner:js=\"import{createRequire as __bannerCreateRequire}from'module';const require=__bannerCreateRequire(import.meta.url);\"",
    "start": "node dist/node.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudarchitect/catalog": "workspace:*",
    "@cloudarchitect/domain": "workspace:*",
    "@cloudarchitect/generator": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "fflate": "0.8.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "license": "Apache-2.0"
}
