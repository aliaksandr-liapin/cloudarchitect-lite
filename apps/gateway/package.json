{
  "name": "@cloudarchitect/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free-AI gateway: credits, budget cap, abuse controls, LLM adapters. Runs on Cloudflare Workers or Node.",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "dev:worker": "wrangler dev",
    "build": "esbuild src/node.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/node.js --sourcemap --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/node.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply cloudarchitect --local"
  },
  "dependencies": {
    "@cloudarchitect/catalog": "workspace:*",
    "@cloudarchitect/domain": "workspace:*",
    "@cloudarchitect/generator": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "license": "Apache-2.0"
}
