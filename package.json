{
  "name": "cloudarchitect-lite",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first AI cloud architecture designer — AWS first, Azure/GCP ready.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @cloudarchitect/web --filter @cloudarchitect/gateway dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval": "pnpm --filter @cloudarchitect/eval run eval",
    "eval:live": "pnpm --filter @cloudarchitect/eval run live",
    "ci": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "screenshots": "pnpm --filter @cloudarchitect/web build && node tools/screenshots.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "type": "module"
}
