  "expectedRequirements": [
    {
      "id": "mqtt",
      "keywords": ["mqtt", "device"]
    },
    {
      "id": "scale",
      "keywords": ["50,000", "50000", "thermostat"]
    },
    {
      "id": "device-certs",
      "keywords": ["certificate", "secure"]
    },
    {
      "id": "sms-alerts",
      "keywords": ["sms", "alert"]
    },
    {
      "id": "history",
      "keywords": ["90 days", "dashboard", "history"]
    }
  ],
  "expectedServices": {
    "required": ["aws.lambda", "aws.sns"],
    "anyOf": [["aws.dynamodb", "aws.opensearch", "aws.s3"]],
    "forbidden": []
  },
  "expectedUnresolved": [
    {
      "id": "iot-ingest",
      "keywords": ["iot core", "iot", "mqtt broker"]
    }
  ],
  "maxErrorFindings": 0
}
