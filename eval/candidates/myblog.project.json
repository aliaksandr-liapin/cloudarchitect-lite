      "requirementIds": ["R2", "R3"],
      "containerId": "region",
      "position": { "x": 0, "y": 0 }
    },
    {
      "id": "mail",
      "provider": "aws",
      "serviceId": "aws.ses",
      "label": "Welcome emails",
      "requirementIds": ["R4"],
      "containerId": "region",
      "position": { "x": 0, "y": 0 }
    },
    {
      "id": "photos",
      "provider": "aws",
      "serviceId": "aws.s3",
      "label": "Photo bucket",
      "requirementIds": ["R5"],
      "containerId": "region",
      "position": { "x": 0, "y": 0 }
    },
    {
      "id": "fn-thumb",
