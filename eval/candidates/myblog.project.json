  "providerContext": ["aws"],
  "catalogSnapshot": { "aws": "aws-catalog-2026.10.0" },
  "iconPackSnapshot": {},
  "requirements": [
    {
      "id": "R1",
      "text": "Global static blog site with low latency",
      "type": "functional",
      "status": "confirmed"
    },
    {
      "id": "R2",
      "text": "REST API for posts and subscriptions",
      "type": "functional",
      "status": "confirmed"
    },
    {
      "id": "R3",
      "text": "Read-heavy data with infrequent writes",
      "type": "non-functional",
      "status": "confirmed"
    },
    {
      "id": "R4",
      "text": "Welcome email for new subscribers",
      "type": "functional",
      "status": "confirmed"
    },
    {
      "id": "R5",
      "text": "Photo upload with thumbnails",
      "type": "functional",
      "status": "confirmed"
    },
    {
      "id": "R6",
      "text": "Authors must sign in before writing posts or uploading photos",
      "type": "functional",
      "status": "inferred"
    },
    {
      "id": "R7",
      "text": "Who may subscribe and how bots are blocked",
      "type": "functional",
      "status": "open"
    }
  ],
  "containers": [
    { "id": "cloud", "kind": "aws-cloud", "label": "AWS" },
    { "id": "region", "kind": "region", "parentId": "cloud", "label": "us-east-1" }
  ],
  "nodes": [
    {
      "id": "dns",
      "provider": "aws",
      "serviceId": "aws.route53",
