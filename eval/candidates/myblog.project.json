      "label": "ObjectCreated",
      "configuration": { "eventNotification": "ObjectCreated", "failureDestination": "dlq" },
      "requirementIds": ["R5"]
    },
    {
      "id": "e10",
      "source": "fn-thumb",
      "target": "photos",
      "kind": "write",
      "label": "thumbnails",
      "requirementIds": ["R5"]
    },
    {
      "id": "e11",
      "source": "fn-thumb",
      "target": "dlq",
      "kind": "write",
      "label": "on failure",
      "requirementIds": ["R5"]
    }
