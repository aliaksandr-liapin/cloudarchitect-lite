      "containerId": "cloud",
      "position": { "x": 0, "y": 0 }
    },
    {
      "id": "site",
      "provider": "aws",
      "serviceId": "aws.s3",
      "label": "Static site bucket",
      "requirementIds": ["R1"],
      "containerId": "region",
      "position": { "x": 0, "y": 0 }
    },
    {
      "id": "auth",
      "provider": "aws",
      "serviceId": "aws.cognito",
      "label": "Author sign-in",
      "requirementIds": ["R6"],
      "containerId": "region",
      "position": { "x": 0, "y": 0 }
    },
    {
      "id": "api",
      "provider": "aws",
      "serviceId": "aws.apigateway",
      "label": "Blog API",
      "requirementIds": ["R2"],
      "containerId": "region",
      "configuration": { "authorizer": "cognito" },
      "position": { "x": 0, "y": 0 }
    },
    {
      "id": "fn-api",
      "provider": "aws",
      "serviceId": "aws.lambda",
