      "serviceId": "aws.lambda",
      "label": "Thumbnail generator",
      "requirementIds": ["R5"],
      "containerId": "region",
      "position": { "x": 0, "y": 0 }
    },
    {
      "id": "dlq",
      "provider": "aws",
      "serviceId": "aws.sqs",
      "label": "Failed thumbnails",
      "requirementIds": ["R5"],
      "containerId": "region",
      "position": { "x": 0, "y": 0 }
    },
    {
      "id": "obs",
      "provider": "aws",
      "serviceId": "aws.cloudwatch",
      "label": "Logs & alarms",
      "requirementIds": [],
      "containerId": "region",
      "position": { "x": 0, "y": 0 }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "dns",
      "target": "cdn",
      "kind": "other",
      "label": "alias",
      "requirementIds": ["R1"]
    },
    {
      "id": "e2",
      "source": "cdn",
      "target": "site",
      "kind": "origin",
      "configuration": { "originAccess": "OAC" },
      "requirementIds": ["R1"]
    },
    {
      "id": "e3",
      "source": "cdn",
      "target": "api",
      "kind": "origin",
      "label": "/api/*",
      "requirementIds": ["R2"]
    },
    {
      "id": "e4",
      "source": "api",
      "target": "auth",
      "kind": "invoke",
      "label": "validate token",
      "requirementIds": ["R6"]
    },
    {
      "id": "e5",
      "source": "api",
      "target": "fn-api",
      "kind": "invoke",
      "protocol": "HTTPS",
      "requirementIds": ["R2"]
    },
    {
      "id": "e6",
      "source": "fn-api",
      "target": "db",
      "kind": "write",
      "requirementIds": ["R2", "R3"]
    },
    {
      "id": "e7",
      "source": "fn-api",
      "target": "mail",
      "kind": "invoke",
      "label": "on subscribe",
      "requirementIds": ["R4"]
    },
    {
      "id": "e8",
      "source": "fn-api",
      "target": "photos",
      "kind": "write",
      "label": "presigned upload URL",
      "configuration": { "presignedUrl": true },
      "requirementIds": ["R5"]
    },
    {
      "id": "e9",
      "source": "photos",
