# Optional. Self-hosted installs are configured by the setup wizard in the browser.
# Anything uncommented here OVERRIDES the wizard (the wizard shows which settings are locked).
# Copy to .env only if you want to preset or lock values; never commit real values.

# Provider keys. Set at least one; models whose provider has no key are not offered.
# Anthropic (Claude): https://platform.claude.com/settings/keys
# ANTHROPIC_API_KEY=
# OpenAI (GPT): https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# Google (Gemini), from AI Studio: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Models enabled on this instance and the default (ADR-0011):
# haiku, sonnet (Claude), gpt-luna, gpt-sol (OpenAI), gemini-flash-lite, gemini-argon (Gemini).
# gpt-luna and gemini-flash-lite are supported but not shown in the editor (below the quality bar,
# see the benchmark report).
# AI_MODELS=haiku
# DEFAULT_MODEL=haiku
# DAILY_BUDGET_MICRO_USD=5000000
# MONTHLY_BUDGET_MICRO_USD=50000000
# RATE_LIMIT_PER_MINUTE=20
# Generated automatically on first start when unset.
# CLIENT_KEY_SALT=
# Set to `disabled` to configure only through environment variables (no wizard).
# SETUP_WIZARD=enabled
# Host port for the web UI.
# WEB_PORT=8080
