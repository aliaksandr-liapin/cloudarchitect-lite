# Optional. Self-hosted installs are configured by the setup wizard in the browser.
# Anything uncommented here OVERRIDES the wizard (the wizard shows which settings are locked).
# Copy to .env only if you want to preset or lock values; never commit real values.

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Models the instance key serves (haiku, sonnet) and the default (ADR-0011).
# AI_MODELS=haiku
# DEFAULT_MODEL=haiku
# FREE_CREDITS=3
# DAILY_BUDGET_MICRO_USD=5000000
# MONTHLY_BUDGET_MICRO_USD=50000000
# RATE_LIMIT_PER_MINUTE=20
# FREE_AI_DISABLED=false
# Generated automatically on first start when unset.
# CLIENT_KEY_SALT=
# Set to `disabled` to configure only through environment variables (no wizard).
# SETUP_WIZARD=enabled
# Host port for the web UI.
# WEB_PORT=8080
